SECRET_KEY=change-me-long-random-string
DATABASE_URL=sqlite:///instance/cartopedia.db

# Cap (captcha auto-hébergé, voir infra/cap). Les 3 valeurs vides = captcha DÉSACTIVÉ (développement).
CAP_ENDPOINT=http://localhost:3000
CAP_SITE_KEY=
CAP_SECRET=
# Widget : épingler la version, ou l'héberger soi-même (ENABLE_ASSETS_SERVER=true côté Cap)
CAP_WIDGET_URL=https://cdn.jsdelivr.net/npm/cap-widget@0.1.58

# Production
COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://

# Wikimedia exige un User-Agent identifiable avec un moyen de contact
WIKI_USER_AGENT=Cartopedia/0.1 (contact: toi@example.com)
